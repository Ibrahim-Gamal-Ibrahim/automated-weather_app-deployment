
pipeline {

    agent {
        label 'weatherapp-agent'
    }

    options {
        skipDefaultCheckout(true)
    }

    environment {
        DOCKERHUB_USER = 'ibrahimgamal10203040'
        DOCKER_CONFIG  = '/home/jenkins/agent/.docker'
    }

    stages {

        // =========================================================
        // 1. CHECKOUT
        // =========================================================

        stage('Checkout') {
            steps {
                container('git') {
                    git branch: 'main',
                        url: 'https://github.com/Ibrahim-Gamal-Ibrahim/automated-weather_app-deployment.git'
                }
            }
        }


        // =========================================================
        // 2. PREPARE DOCKER HUB AUTHENTICATION
        // =========================================================

        stage('Prepare Docker Auth') {
            steps {
                container('buildkit-auth') {

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )
                    ]) {

                        sh '''
                            echo "Preparing Docker Hub authentication..."

                            mkdir -p ${DOCKER_CONFIG}

                            AUTH=$(printf "%s:%s" "$DOCKER_USER" "$DOCKER_PASS" \
                                | base64 | tr -d '\\n')

                            cat > ${DOCKER_CONFIG}/config.json <<EOF
{
  "auths": {
    "https://index.docker.io/v1/": {
      "auth": "$AUTH"
    }
  }
}
EOF
                        '''
                    }
                }
            }
        }


        // =========================================================
        // 3. BUILD ALL IMAGES IN PARALLEL
        // =========================================================

        stage('Build Images') {

            parallel {

                // -------------------------------------------------
                // AUTH
                // -------------------------------------------------

                stage('Build Auth') {
                    steps {
                        container('buildkit-auth') {

                            sh '''
                                echo "Building Auth image..."

                                export DOCKER_CONFIG=${DOCKER_CONFIG}

                                buildctl-daemonless.sh build \
                                  --frontend dockerfile.v0 \
                                  --local context=auth \
                                  --local dockerfile=auth \
                                  --output type=image,name=${DOCKERHUB_USER}/weatherapp-auth:latest,push=true
                            '''
                        }
                    }
                }


                // -------------------------------------------------
                // UI
                // -------------------------------------------------

                stage('Build UI') {
                    steps {
                        container('buildkit-ui') {

                            sh '''
                                echo "Building UI image..."

                                export DOCKER_CONFIG=${DOCKER_CONFIG}

                                buildctl-daemonless.sh build \
                                  --frontend dockerfile.v0 \
                                  --local context=ui \
                                  --local dockerfile=ui \
                                  --output type=image,name=${DOCKERHUB_USER}/weatherapp-ui:latest,push=true
                            '''
                        }
                    }
                }


                // -------------------------------------------------
                // WEATHER
                // -------------------------------------------------

                stage('Build Weather') {
                    steps {
                        container('buildkit-weather') {

                            sh '''
                                echo "Building Weather image..."

                                export DOCKER_CONFIG=${DOCKER_CONFIG}

                                buildctl-daemonless.sh build \
                                  --frontend dockerfile.v0 \
                                  --local context=weather \
                                  --local dockerfile=weather \
                                  --output type=image,name=${DOCKERHUB_USER}/weatherapp-weather:latest,push=true
                            '''
                        }
                    }
                }
            }
        }


        // =========================================================
        // 4. TRIGGER CD PIPELINE
        // =========================================================

        stage('Trigger CD') {
            steps {

                echo 'CI succeeded. Triggering CD pipeline...'

                build job: 'weatherapp-cd',
                      wait: false,
                      propagate: false
            }
        }
    }


    // =============================================================
    // PIPELINE RESULT
    // =============================================================

    post {

        success {
            echo '''
================================================
 CI PIPELINE COMPLETED SUCCESSFULLY
 CD PIPELINE WAS TRIGGERED
================================================
'''
        }

        failure {
            echo '''
================================================
 CI PIPELINE FAILED
 CD PIPELINE WILL NOT CONTINUE SUCCESSFULLY
================================================
'''
        }

        always {
            echo 'CI pipeline finished.'
        }
    }
}

